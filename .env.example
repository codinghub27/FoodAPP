# Copy to .env and fill in your own values. Never commit .env.
SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Option A: one database URL
DATABASE_URL=postgres://user:password@localhost:5432/foodapp

# Option B: separate values (used when DATABASE_URL is empty)
DB_NAME=foodapp
DB_USER=postgres
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432

# Used by build.sh to create an admin on deploy
DJANGO_SUPERUSER_USERNAME=
DJANGO_SUPERUSER_EMAIL=
DJANGO_SUPERUSER_PASSWORD=
